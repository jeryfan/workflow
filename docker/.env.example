# Copy to docker/.env and replace every required value.
POSTGRES_PASSWORD=
FILE_SIGNING_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SANDBOX_API_KEY=

# Set the public HTTPS origin before exposing this deployment.
PUBLIC_ORIGIN=http://localhost
WEB_PORT=80
CELERY_CONCURRENCY=2

# Optional one-time import into a new, empty PostgreSQL database.
# MIGRATE_FROM_SQLITE=/legacy/workflow.db
